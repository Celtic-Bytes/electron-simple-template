# .npmrc - Required Security Options and Best Practices

# 1. ignore-scripts=true
# Prevents npm from automatically executing pre/post install scripts defined by packages or their dependencies.
# This prevents the silent execution of potentially malicious code (ransomware/trojans) during an npm install.
# NOTE: It may require manually running `npm rebuild <package>` if you install packages that need to compile binaries (e.g., esbuild, sqlite3 or electron).
ignore-scripts=true

# 2. save-exact=true
# Forces dependencies in package.json to be saved with their exact version ("1.2.3" instead of "^1.2.3").
# Precludes accidental installation of unsought, breaking changes or injected code in minor updates.
save-exact=true

# 3. audit=true
# Ensures vulnerability reporting tools are run on every package or dependency installation,
# exposing known security breaches and suggesting imminent upgrades.
audit=true

# 4. engine-strict=true
# Forces an error when running the project or installing packages in Node and npm versions that are incompatible
# with the ones declared in the `engines` block of package.json, maintaining a rigorous unified execution control.
engine-strict=true

# 5. fund=false
# Avoids showing donation alerts/messages from the npm community during installations; reduces noise in the terminal.
fund=false